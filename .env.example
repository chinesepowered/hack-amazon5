# Model for the Strands agent and the snapshot describer (any OpenAI-compatible endpoint)
OPENAI_BASE_URL=https://api.inference.wandb.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=Qwen/Qwen3.8-27B
OPENAI_VISION_MODEL=Qwen/Qwen3.8-27B

# Ring mode:
#   simulator = signed mock webhooks + demo scenes, no network (default)
#   hybrid    = real Ring device reads (GET /v1/devices, capabilities, status, event history)
#               with simulated events, snapshots and chime audio, labeled per element in the UI.
#               Needs RING_ACCESS_TOKEN; without one it degrades to simulator.
#   live      = everything against api.amazonvision.com
RING_MODE=simulator
# HMAC signature key from the Ring Developer Console (the simulator signs with this too)
RING_WEBHOOK_SECRET=

# A Developer Playground access token (~30 min) is enough for hybrid mode
RING_ACCESS_TOKEN=
# ... or OAuth credentials for a linked account (do not set both)
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=

# Live mode only: map your real Ring device ids onto the household roles
RING_DEVICE_FRONT_DOOR=
RING_DEVICE_DRIVEWAY=
RING_DEVICE_CHIME=
# Live mode only: chime audio slot to play for the calm voice message (see FRICTION_LOG.md #1)
RING_CHIME_AUDIO_REF=
