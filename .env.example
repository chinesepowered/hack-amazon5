# Model for the Strands agent and the snapshot describer (any OpenAI-compatible endpoint)
OPENAI_BASE_URL=https://api.inference.wandb.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=Qwen/Qwen3.8-27B
OPENAI_VISION_MODEL=Qwen/Qwen3.8-27B

# Ring: "simulator" (signed mock webhooks + bundled snapshots) or "live" (api.amazonvision.com)
RING_MODE=simulator
# HMAC signature key from the Ring Developer Console (simulator mode signs with this too)
RING_WEBHOOK_SECRET=

# Live mode only: a Developer Playground access token (~30 min) ...
RING_ACCESS_TOKEN=
# ... or OAuth credentials for a linked account (do not set both)
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=

# Live mode only: map your real Ring device ids onto the household roles
RING_DEVICE_FRONT_DOOR=
RING_DEVICE_DRIVEWAY=
RING_DEVICE_CHIME=
# Chime audio slot to play for the calm voice message (see docs/ring-live-checklist.md)
RING_CHIME_AUDIO_REF=
